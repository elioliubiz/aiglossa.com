{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "scholan.aiglossa.com"
        }
      ],
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/protocol/privacy.html",
      "destination": "/en/protocol/privacy.html",
      "permanent": true
    },
    {
      "source": "/protocol/term.html",
      "destination": "/en/protocol/term.html",
      "permanent": true
    },
    {
      "source": "/protocol/delete-account.html",
      "destination": "/en/protocol/delete-account.html",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/pricing.html",
      "permanent": true
    },
    {
      "source": "/account.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/account.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/inapp",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/sites/root/inapp.html"
    },
    {
      "source": "/:lang/",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/sites/root/:lang/index.html"
    },
    {
      "source": "/:lang/",
      "has": [
        {
          "type": "host",
          "value": "scholan.aiglossa.com"
        }
      ],
      "destination": "/sites/scholan/:lang/index.html"
    },
    {
      "source": "/:lang/",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/sites/tools/:lang/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/sites/root/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "scholan.aiglossa.com"
        }
      ],
      "destination": "/sites/scholan/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/sites/tools/:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
