{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/:lang/make.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/:lang/music/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "scholan.aiglossa.com"
        }
      ],
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^zh-(TW|HK|MO|Hant|tw|hk|mo).*"
        }
      ],
      "destination": "/zh-Hant/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^zh.*"
        }
      ],
      "destination": "/zh-Hans/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ja.*"
        }
      ],
      "destination": "/ja/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ko.*"
        }
      ],
      "destination": "/ko/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^es.*"
        }
      ],
      "destination": "/es/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^pt.*"
        }
      ],
      "destination": "/pt/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr.*"
        }
      ],
      "destination": "/fr/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^de.*"
        }
      ],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^it.*"
        }
      ],
      "destination": "/it/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ru.*"
        }
      ],
      "destination": "/ru/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^ar.*"
        }
      ],
      "destination": "/ar/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^th.*"
        }
      ],
      "destination": "/th/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^vi.*"
        }
      ],
      "destination": "/vi/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^id.*"
        }
      ],
      "destination": "/id/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^tr.*"
        }
      ],
      "destination": "/tr/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/protocol/privacy.html",
      "destination": "/en/protocol/privacy.html",
      "permanent": true
    },
    {
      "source": "/protocol/term.html",
      "destination": "/en/protocol/term.html",
      "permanent": true
    },
    {
      "source": "/protocol/delete-account.html",
      "destination": "/en/protocol/delete-account.html",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/pricing.html",
      "permanent": true
    },
    {
      "source": "/account.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/account.html",
      "permanent": true
    },
    {
      "source": "/refund.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/refund.html",
      "permanent": true
    },
    {
      "source": "/acceptable-use.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/acceptable-use.html",
      "permanent": true
    },
    {
      "source": "/make.html",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/en/music/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/inapp",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/sites/root/inapp.html"
    },
    {
      "source": "/:lang/guides/",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/sites/tools/:lang/guides/index.html"
    },
    {
      "source": "/:lang/music/",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/sites/tools/:lang/music/index.html"
    },
    {
      "source": "/:lang/",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/sites/root/:lang/index.html"
    },
    {
      "source": "/:lang/",
      "has": [
        {
          "type": "host",
          "value": "scholan.aiglossa.com"
        }
      ],
      "destination": "/sites/scholan/:lang/index.html"
    },
    {
      "source": "/:lang/",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/sites/tools/:lang/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "destination": "/sites/root/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "scholan.aiglossa.com"
        }
      ],
      "destination": "/sites/scholan/:path*"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tools.aiglossa.com"
        }
      ],
      "destination": "/sites/tools/:path*"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "has": [
        {
          "type": "host",
          "value": "aiglossa.com"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
